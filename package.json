{
  "name": "perks-launchpad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "readiness": "node workers/readiness.cjs",
    "test": "tsc -p tsconfig.tests.json && node --test test-results/compiled/tests/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "worker": "tsx workers/indexer.ts",
    "cards:setup": "node workers/setup-card-payments.cjs",
    "cards:worker": "tsx workers/card-payments.ts",
    "orders:reconcile": "tsx workers/reconcile.ts",
    "treasury:swap": "tsx workers/treasury.ts",
    "treasury:collect": "tsx workers/collect.ts",
    "orders:refund": "tsx workers/refund.ts"
  },
  "dependencies": {
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@prisma/client": "^6.19.0",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@pump-fun/pump-sdk": "2.0.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@marsidev/react-turnstile": "^1.3.1",
    "ioredis": "^5.8.2",
    "tweetnacl": "^1.0.3",
    "bs58": "^6.0.0",
    "zod": "^3.25.76",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "server-only": "^0.0.1",
    "@next/env": "15.5.25"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "tailwindcss": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16"
  }
}
