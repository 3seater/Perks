# Copy to .env.production in the repository root. Never commit that file.
PERKS_DOMAIN=perksp.ad
# Generate 32 random bytes as hex. Hex avoids URL password escaping issues.
POSTGRES_PASSWORD=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Browser-safe RPC only; never place a server-only API credential here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=
APP_ORIGIN=https://perksp.ad
PERKS_CUSTODY_MODE=wallet
PERKS_TREASURY_ADDRESS=
REWARD_BPS=9500
INDEXER_MODE=targeted
# Preserve the existing database cursor. Never set a new tip to skip old trades.
INDEXER_START_SLOT=
INDEXER_MAX_LAG_SLOTS=150
METADATA_PROVIDER=pump
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=perksp.ad
TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Keep paused for migration and verification. Empty pilot allows public access
# only after LAUNCHES_ENABLED=true and real Turnstile keys are configured.
LAUNCHES_ENABLED=false
PILOT_LAUNCH_WALLET=
COLLECTIONS_ENABLED=false
CARD_CATALOG_ENABLED=false
CARD_REDEMPTIONS_ENABLED=false
AUTO_COLLECTION_ENABLED=false
CRYPTOREFILLS_PARTNER_ID=
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_FEE_CAP_LAMPORTS=10000
CARD_MAX_ORDER_LAMPORTS=100000000
CARD_MAX_DAILY_LAMPORTS=500000000
AUTO_COLLECTION_MIN_LAMPORTS=1000000
AUTO_REFILL_TARGET_LAMPORTS=100000000
TREASURY_RESERVE_LAMPORTS=10000000
# Must match the EXISTING key when restoring encrypted orders/vouchers.
VOUCHER_ENCRYPTION_KEY=
JUPITER_API_KEY=
HELIUS_WEBHOOK_SECRET=
CLAIMS_ENABLED=false
TREASURY_AUTOSWAP_ENABLED=false
