# Demo is explicit; no network mutations or redeemable vouchers in demo mode.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://perks:perks@localhost:5432/perks
REDIS_URL=redis://localhost:6379
# Set after deploying the included vault program; PDA seed is perks-vault.
PERKS_CUSTODY_MODE=wallet
PERKS_TREASURY_ADDRESS=
PERKS_VAULT_PROGRAM_ID=
PERKS_VAULT_ADDRESS=
CLAIMS_ENABLED=false
LAUNCHES_ENABLED=false
# Finalized slot BEFORE the first Perks launch; archival getBlock RPC required.
INDEXER_START_SLOT=
INDEXER_MODE=targeted
INDEXER_MAX_LAG_SLOTS=150
COLLECTIONS_ENABLED=false
# Explicit rate chosen after cost validation; intentionally no live default.
# Integer basis points, 0..9999. Snapshotted per earning; never retroactively changed.
REWARD_BPS=
# Read-only catalog and price estimates; does not enable orders or payments.
CARD_CATALOG_ENABLED=false
CRYPTOREFILLS_PARTNER_ID=
# Automated native-SOL card checkout; setup script creates a separate payment wallet.
CARD_REDEMPTIONS_ENABLED=false
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_FEE_CAP_LAMPORTS=10000
CARD_MAX_ORDER_LAMPORTS=100000000
CARD_MAX_DAILY_LAMPORTS=500000000
AUTO_COLLECTION_ENABLED=false
AUTO_COLLECTION_MIN_LAMPORTS=1000000
AUTO_REFILL_TARGET_LAMPORTS=100000000
# Production only: header overwritten by your trusted ingress, e.g. x-real-ip.
TRUSTED_CLIENT_IP_HEADER=
HELIUS_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAME=localhost
RELOADLY_SANDBOX=true
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# Verify US / USD product IDs and denominations in your Reloadly catalog.
RELOADLY_DOORDASH_PRODUCT_ID=
RELOADLY_UBER_PRODUCT_ID=
RELOADLY_AMAZON_PRODUCT_ID=
RELOADLY_STEAM_PRODUCT_ID=
# 32 random bytes, base64 encoded. Never expose via NEXT_PUBLIC_.
VOUCHER_ENCRYPTION_KEY=
JUPITER_API_KEY=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Isolated treasury worker ONLY. Keep these out of web-server environment.
TREASURY_AUTOSWAP_ENABLED=false
TREASURY_KEYPAIR_PATH=
TREASURY_DAILY_SWAP_LAMPORTS=100000000
TREASURY_RESERVE_LAMPORTS=10000000
